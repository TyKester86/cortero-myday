# MyDay API config. On the droplet this lives at /opt/myday/.env (never in git).
# Copy to api/.env for local development.

NODE_ENV=production
PORT=4000
# Household time zone — "today", weekdays and week starts are computed here.
TZ_HOUSEHOLD=America/Chicago
# Public origin, used to build the OAuth redirect URI.
PUBLIC_URL=https://staging.conquermyday.app

# Postgres: database "myday", its own role (never the Opsentra credentials).
DATABASE_URL=postgresql://myday:CHANGE_ME@postgres:5432/myday

# Long random string (e.g. `openssl rand -hex 32`).
SESSION_SECRET=

# Google OAuth client (Web application). Redirect URI:
#   ${PUBLIC_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional comma-separated emails allowed to sign in even before they are on
# the household roster (bootstrap the first parent). Roster emails always work.
ALLOWED_EMAILS=

# Ask Hana + homework tutor (Claude). Leave blank and the chat says "not set up".
ANTHROPIC_KEY=
# Optional model override (default: claude-opus-5-5).
CHAT_MODEL=

# Money (Plaid, read-only). PLAID_ENV = sandbox | production.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# 64 hex chars (openssl rand -hex 32). Encrypts bank access tokens at rest.
# Required in production; changing it orphans already-linked banks (relink them).
MONEY_TOKEN_KEY=

# Lecture capture: speech-to-text (any OpenAI-compatible Whisper endpoint).
# Blank = recording works but notes say transcription isn't set up.
TRANSCRIPTION_KEY=
TRANSCRIPTION_URL=
TRANSCRIPTION_MODEL=

# Web push (gentle daily nudges). The private key is a SECRET: generate it on
# the server, never commit it. On the droplet:
#   docker exec myday-api node -e "const w=require('web-push');const k=w.generateVAPIDKeys();console.log('VAPID_PUBLIC_KEY='+k.publicKey+'
VAPID_PRIVATE_KEY='+k.privateKey)" >> /opt/myday/.env
#   then set VAPID_SUBJECT=mailto:<your address> and: cd /opt/myday && docker compose up -d --force-recreate myday-api
# Keep the same pair forever: changing it silently drops every existing subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Signup: true = anyone with Google can create a household (30-day trial).
SIGNUP_OPEN=true

# Google Classroom import reuses GOOGLE_CLIENT_ID/SECRET; add this redirect URI
# in the Google console: <PUBLIC_URL>/api/classroom/callback (and enable the Classroom API).

# LOCAL ONLY (refused when NODE_ENV=production):
#   TRANSCRIPTION_STUB=1  canned lecture transcript instead of Whisper
#   PUSH_STUB=1           record nudges instead of sending them
#   CLASSROOM_PROVIDER=fake  three sample courses instead of Google Classroom
#   MONEY_PROVIDER=fake   deterministic demo bank data instead of Plaid
#   CHAT_STUB=1           canned AI replies instead of calling Claude

# TEMPORARY — verification only. When set, /dev-login?token=...&member=<key>
# creates a real session without Google. Leave EMPTY in normal operation.
DEV_LOGIN_TOKEN=
