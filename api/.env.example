# MyDay API config. On the droplet this lives at /opt/myday/.env (never in git).
# Copy to api/.env for local development.

NODE_ENV=production
PORT=4000
# Household time zone — "today", weekdays and week starts are computed here.
TZ_HOUSEHOLD=America/Chicago
# Public origin, used to build the OAuth redirect URI.
PUBLIC_URL=https://staging.conquermyday.app

# Postgres: database "myday", its own role (never the Opsentra credentials).
DATABASE_URL=postgresql://myday:CHANGE_ME@postgres:5432/myday

# Long random string (e.g. `openssl rand -hex 32`).
SESSION_SECRET=

# Google OAuth client (Web application). Redirect URI:
#   ${PUBLIC_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional comma-separated emails allowed to sign in even before they are on
# the household roster (bootstrap the first parent). Roster emails always work.
ALLOWED_EMAILS=

# TEMPORARY — verification only. When set, /dev-login?token=...&member=<key>
# creates a real session without Google. Leave EMPTY in normal operation.
DEV_LOGIN_TOKEN=
