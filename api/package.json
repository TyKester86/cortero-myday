{
  "name": "@myday/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --env-file-if-exists=.env --watch dist/server.js",
    "start": "node dist/migrate.js && node dist/server.js",
    "migrate": "node --env-file-if-exists=.env dist/migrate.js",
    "cli": "node --env-file-if-exists=.env dist/cli.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@myday/shared": "*",
    "connect-pg-simple": "^10.0.0",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "pg": "^8.23.1",
    "playwright-core": "^1.63.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "typescript": "^7.0.2"
  }
}
