{
  "id": "/?app=the-feed",
  "name": "The Feed",
  "short_name": "The Feed",
  "description": "A calm, supportive community for ADHD adults. Free, 18+.",
  "start_url": "/feed?source=pwa",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#12100E",
  "theme_color": "#1F1714",
  "categories": ["social", "lifestyle"],
  "icons": [
    { "src": "/icons/feed-icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/feed-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/feed-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/feed-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/feed-horn.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Messages", "url": "/messages", "icons": [{ "src": "/icons/feed-icon-192.png", "sizes": "192x192" }] },
    { "name": "Villages", "url": "/village", "icons": [{ "src": "/icons/feed-icon-192.png", "sizes": "192x192" }] }
  ]
}
