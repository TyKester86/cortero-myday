# /opt/myday-prod/.env on the PRODUCTION server — copy this file there, fill it in,
# chmod 600. Never commit the real file. Generate secrets with: openssl rand -hex 32
NODE_ENV=production
PUBLIC_URL=https://conquermyday.app
PORT=4000
TZ_HOUSEHOLD=America/Chicago

# Database (the db service in docker-compose.yml). The app runs as its own
# non-superuser role so row-level security can never be bypassed.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=
DATABASE_URL=postgres://myday:<password>@db:5432/myday

# Sessions + encryption keys (64 hex chars each). Keep copies in a password manager.
SESSION_SECRET=
MONEY_TOKEN_KEY=
PHOTO_KEY=
# Seals Village + Feed posts, bios and photos at rest. Set it before launch and never change it.
CONTENT_KEY=

# NEVER set DEV_LOGIN_TOKEN in production.

# Sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
SIGNUP_OPEN=true
ADMIN_EMAILS=

# Email (Resend) — sign-in links, invites, trial reminders
MAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_FROM=MyDay <hello@conquermyday.app>

# Payments (Stripe)
BILLING_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AI (Hana, tutor, lecture notes, community pre-screen) + transcription.
# Without ANTHROPIC_KEY in production, every community post waits for a moderator.
ANTHROPIC_KEY=
# Optional: the model for the community pre-screen (defaults to CHAT_MODEL).
SCREEN_MODEL=

# Push notifications (web push). Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@conquermyday.app

# Forward to Hana: the inbound-email domain (MX record → your inbound provider)
# and the secret in the webhook URL: https://<app>/inbound/email?key=<INBOUND_SECRET>
INBOUND_DOMAIN=in.conquermyday.app
INBOUND_SECRET=

# Grocery ordering (Hana step 3). Instacart Developer Platform key, and a
# Kroger app (redirect URI https://<app>/api/grocery/kroger/callback).
INSTACART_API_KEY=
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# Flight prices for Hana (optional; without it she gives Google Flights / Kayak links)
DUFFEL_API_KEY=
TRANSCRIPTION_KEY=

# Banks (Plaid, production access)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production

# Push notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@conquermyday.app

# Monitoring
SENTRY_DSN=
ERROR_WEBHOOK_URL=

# Fair-use limits (optional; these are the defaults)
# AI_MONTHLY_MESSAGES=1500
# LECTURE_MONTHLY_MINUTES=1200
# LECTURES_PER_DAY=8
# PHOTOS_PER_DAY=24
# SIGNUPS_PER_HOUR=5

# Backups (see docs/BACKUP-RESTORE.md)
# The production compose network (backup.sh reaches the db container through it).
BACKUP_DOCKER_NETWORK=myday-prod_default
BACKUP_KEY_FILE=/opt/myday-prod/backup.key
BACKUP_DIR=/opt/myday-prod/backups
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
